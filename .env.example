# Copy to .env for local Docker Compose use. Replace placeholders locally.
TESTCASE_DB_NAME=testcase_agent
TESTCASE_DB_USERNAME=testcase_agent
TESTCASE_DB_PASSWORD=change-this-local-password
TESTCASE_DB_ROOT_PASSWORD=change-this-local-root-password
TESTCASE_DB_PORT=3307
TESTCASE_ARTIFACT_ROOT=./var/artifacts
TESTCASE_KNOWLEDGE_AGENT_ENABLED=false
# Configure externally for a live run. Never commit the key value.
TESTCASE_KNOWLEDGE_AGENT_API_BASE_URL=http://localhost/api/v1
TESTCASE_KNOWLEDGE_AGENT_API_KEY=
# Required together before enabling the external agent. Project is an optional fine-grained coordinate;
# blank project does not broaden the required KB/system/version/category/document whitelist.
TESTCASE_TASK_SCOPE_OPTION_ID=strategic-v1-admission
TESTCASE_TASK_SCOPE_LABEL=战略运管 V1.0 准入材料
# These non-secret defaults are supplied by application.yml for the configured acceptance scope.
TESTCASE_TASK_AGENT_ID=005876e2-a62f-41f3-8807-29bfd3f1e257
TESTCASE_REQUIREMENT_KNOWLEDGE_BASE_ID=abd55572-af4b-44e9-820b-3a8a5e645664
TESTCASE_REQUIREMENT_SYSTEM_ID=zlyg
TESTCASE_REQUIREMENT_VERSION_ID=bc894091-fa19-4ee7-8ed6-2558c0d5434f
TESTCASE_REQUIREMENT_PROJECT_ID=
TESTCASE_REQUIREMENT_DOCUMENT_IDS=c32e32ab-a8c3-4a0b-9440-c941145c3cde,b9a90ef9-5abf-4865-ba7f-d81a1fedf7f7
TESTCASE_REQUIREMENT_ADMISSION_TYPE_KEYS=function_list,work_order_plan
TESTCASE_EXAMPLE_KNOWLEDGE_BASE_ID=1a2f0a98-546e-4cd0-a437-b17e866a21ac
TESTCASE_EXAMPLE_GOOD_DOCUMENT_IDS=37c38fdc-3cb1-465d-b4b9-5226af6fd98d
TESTCASE_EXAMPLE_BAD_DOCUMENT_IDS=4071c86e-7037-4101-a57b-809bb109e536
